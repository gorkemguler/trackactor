{
  "manifest_version": 3,
  "name": "trackactor",
  "version": "0.1.0",
  "description": "Capture a case ID or a threat-actor handle into trackactor from the page you're on, and link it to a case.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "trackactor",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["src/content/telegram.js"],
      "run_at": "document_idle"
    }
  ]
}
