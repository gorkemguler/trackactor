# Copy to .env and adjust as needed.

# SQLAlchemy database URL. Default is a local SQLite file.
TRACKACTOR_DB_URL=sqlite:///./trackactor.db

# Comma-separated list of allowed CORS origins (the frontend dev server).
TRACKACTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Require an X-API-Key on every /api call (writes need a "write"-scoped key).
# Off by default so a fresh clone just runs.
TRACKACTOR_REQUIRE_KEY=false

# Guards /api/keys and /api/webhooks. Empty = those routes are open (local use).
TRACKACTOR_ADMIN_TOKEN=
