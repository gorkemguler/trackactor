# Copy to .env and adjust as needed.

# SQLAlchemy database URL. Default is a local SQLite file.
# For Postgres: postgresql+psycopg://user:pass@host:5432/trackactor
TRACKACTOR_DB_URL=sqlite:///./trackactor.db

# Comma-separated list of allowed CORS origins (the frontend dev server).
TRACKACTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Require an X-API-Key on every /api call (writes need a "write"-scoped key).
# Off by default so a fresh clone just runs.
TRACKACTOR_REQUIRE_KEY=false

# Require a logged-in session for the web UI and /api (an X-API-Key still works
# for automation).
TRACKACTOR_REQUIRE_LOGIN=false
TRACKACTOR_SESSION_TTL_HOURS=12

# Guards /api/keys, /api/webhooks and user creation. When empty, those routes
# are open ONLY on an otherwise-unlocked instance; if REQUIRE_KEY or
# REQUIRE_LOGIN is on, set this (or sign in as an admin) to reach them.
TRACKACTOR_ADMIN_TOKEN=

# Evidence file storage and the per-file size cap.
TRACKACTOR_DATA_DIR=./data
TRACKACTOR_MAX_UPLOAD_MB=25

# Connection pool (non-sqlite only).
TRACKACTOR_DB_POOL_SIZE=5
TRACKACTOR_DB_MAX_OVERFLOW=10
